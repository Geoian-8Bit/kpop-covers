# Supabase project → Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only (no VITE_ prefix): YouTube Data API v3 key for /api/youtube-search. Optional locally.
YOUTUBE_API_KEY=

# Avisos del calendario (Web Push, REQ-05). Public VAPID key (`npx web-push generate-vapid-keys`). Empty: the
# «Avisos» switch hides and nothing breaks. The private key and the webhook secret live only in Supabase secrets
# (docs/DEPLOY.md, «Avisos del calendario»), never here.
VITE_VAPID_PUBLIC_KEY=
