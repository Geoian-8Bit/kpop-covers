{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "env": {
        "NODE_OPTIONS": "--use-system-ca"
      },
      "port": 5173
    },
    {
      "name": "web-demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev",
        "--port",
        "5174",
        "--strictPort"
      ],
      "env": {
        "NODE_OPTIONS": "--use-system-ca",
        "VITE_DEMO": "true"
      },
      "port": 5174
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@coverscape/web",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}
